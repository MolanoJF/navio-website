":[[\"$\",\"strong\",null,{\"children\":\"Controller vs. processor.\"}],\" For our own website, sales, support, and account data, Navio is a \",[\"$\",\"strong\",null,{\"children\":\"data controller\"}],\". When customers deploy our snippet/agent inside their product, Navio generally acts as a \",[\"$\",\"strong\",null,{\"children\":\"data processor/service provider\"}],\" on their instructions and contract; the customer's own privacy notice governs what they collect from End Users in their app.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-6\",\"children\":\"2) Information We Collect\"}],\"$L5\"]}],\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\"]}]]}],\"$L18\"]}],null,\"$L19\"]}],{},null,false]},null,false]},null,false]},null,false],\"$L1a\",false]],\"m\":\"$undefined\",\"G\":[\"$1b\",[]],\"s\":false,\"S\":true}\n1c:I[6821,[\"578\",\"static/chunks/578-9370796a8416175a.js\",\"874\",\"static/chunks/874-731ee3ee27bcf85c.js\",\"5\",\"static/chunks/5-72c20c2d9d2aecdb.js\",\"567\",\"static/chunks/app/legal/privacy/page-077b4d2d8291a54d.js\"],\"default\"]\n1d:I[59665,[],\"OutletBoundary\"]\n1f:I[74911,[],\"AsyncMetadataOutlet\"]\n21:I[59665,[],\"ViewportBoundary\"]\n23:I[59665,[],\"MetadataBoundary\"]\n24:\"$Sreact.suspense\"\n5:[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold text-foreground mb-3\",\"children\":\"A) Information you provide\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"Account/contact details (name, email, role), billing info, messages, and content you upload or connect (e.g., product docs, release notes, support content).\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold text-foreground mb-3\",\"children\":\"B) Information we collect automatically\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-foreground/80\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Usage & device data.\"}],\" IP address, identifiers, browser/OS, pages and actions, session metadata, event timestamps, and diagnostics/logs.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"In-app interaction data.\"}],\" UI elements Navio highlights, steps shown, clicks/actions executed by Autopilot (when enabled), success/failure events, and performance/latency metrics.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Cookies & similar tech.\"}],\" To run the widget, keep you signed in, measure usage, and improve the product (see \\\"Cookies\\\" below).\"]}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold text-foreground mb-3\",\"children\":\"C) From integrations & third parties (optional)\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"If you connect tools (e.g., Zendesk/Intercom/help center/analytics), we receive the data you authorize through those integrations to surface guidance and context. Your use of those tools is governed by their policies.\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold text-foreground mb-3\",\"children\":\"D) De-identified/aggregated data\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"We may create de-identified or aggregated datasets for benchmarking, trends, and product improvement; we do not attempt to re-identify individuals from such data.\"}]]}]]}]\n6:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"3) How We Use Information\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-foreground/80 mb-4\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"Provide, secure, maintain, and improve the Services (including the widget, guidance, Autopilot, analytics, and dashboards).\"}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"Configure and operate flows you define (e.g., role-based rules, approvals, rate limits), surface contextual help, and produce insights like intent heatmaps and drop-off points.\"}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"Communicate with you (product updates, support, security, billing) and run core business operations (fraud prevention, audits, compliance).\"}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"Develop new features, quality assurance, and research (including aggregated analysis).\"}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"With your consent, send marketing; you can opt out anytime.\"}]]}],[\"$\",\"div\",null,{\"className\":\"bg-accent/5 border border-accent/20 rounded-lg p-4\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-foreground/80\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Legal bases (EEA/UK/Switzerland):\"}],\" We rely on performance of contract, legitimate interests (e.g., to secure and improve the Services), consent (where required, e.g., certain cookies/marketing), and legal obligations.\"]}]}]]}]\n7:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"4) Product-Specific Notes (Guidance & Autopilot)\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3 text-foreground/80\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Guidance.\"}],\" We process UI context, events, and your connected content to show step-by-step instructions and in-app help.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Autopilot (optional).\"}],\" When you enable it, Navio executes permitted clicks/navigation and logs execution metadata for observability and audit. Customers control scope, permissions, and approvals in their environment.\"]}]]}]]}]\n8:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"5) Cookies & Similar Technologies\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"We use cookies, local storage, and similar technologies to run core features (authentication, session continuity), remember preferences, and analyze usage/performance. Where required, we'll request consent and provide choices (e.g., cookie banner). You can manage cookies via your browser; blocking some cookies may impact functionality.\"}]]}]\n9:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"6) How We Share Information\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed mb-4\",\"children\":\"We share information with:\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3 text-foreground/80 mb-4\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Service providers/subprocessors\"}],\" (cloud hosting, security, analytics, email, customer support) under contracts requiring confidentiality and appropriate safeguards.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Integrations you enable\"}],\" (help desks, analytics, knowledge sources) as instructed by you.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Professional advisors\"}],\" and \",[\"$\",\"strong\",null,{\"children\":\"law enforcement\"}],\" when required by law or to protect rights, safety, and security.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Corporate transactions\"}],\" (merger, acquisition) with continuity of protections.\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":[\"We also disclose \",[\"$\",\"strong\",null,{\"children\":\"aggregated/de-identified\"}],\" insights that do not identify individuals.\"]}]]}]\na:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"7) International Transfers\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"We may transfer, store, and process information in countries outside your own. When required, we use appropriate safeguards (e.g., Standard Contractual Clauses and comparable mechanisms) and implement technical/organizational measures to protect data during transfer and at rest/in transit.\"}]]}]\nb:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"8) Security\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"We implement technical and organizational measures to protect information, including industry-standard encryption in transit and at rest, access controls/roles, rate limiting/abuse protections, and vulnerability management. No system is 100% secure; we maintain programs to prevent, detect, and respond to incidents.\"}]]}]\nc:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"9) Data Retention\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"We retain personal information for as long as needed to provide the Services, comply with legal obligations, resolve disputes, enforce agreements, and for legitimate business needs. Customers can configure or request export/deletion consistent with our retention practices and applicable law.\"}]]}]\nd:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"10) Your Privacy Rights\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed mb-4\",\"children\":\"Depending on where you live, you may have rights to:\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-foreground/80 mb-4\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"Access, correct, update, or delete your personal information;\"}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"Object to or restrict processing;\"}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"Port your data;\"}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"Withdraw consent where processing is based on consent;\"}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"Lodge a complaint with a supervisory authority.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed mb-4\",\"children\":[\"End Users should direct requests to the relevant \",[\"$\",\"strong\",null,{\"children\":\"customer\"}],\" (the controller for in-app data); we'll support them as the processor. You can also contact Navio for our own controller data.\"]}],[\"$\",\"div\",null,{\"className\":\"bg-accent/5 border border-accent/20 rounded-lg p-4\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-foreground/80\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"U.S. state laws (e.g., CA/VA/CO/CT/UT):\"}],\" If these apply, you may have additional rights regarding access, deletion, correction, and opt-out of \\\"sale,\\\" \\\"sharing,\\\" or targeted advertising. We do not sell personal information as defined by these laws, and we honor applicable opt-out rights. (We provide mechanisms to limit cross-context behavioral advertising where required.)\"]}]}]]}]\ne:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"11) Children's Privacy\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"The Services are not directed to children under 16, and we do not knowingly collect personal information from them. If we learn we've collected such data, we'll delete it.\"}]]}]\nf:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"12) Do Not Track & Global Privacy Control\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"Some browsers offer \\\"Do Not Track\\\" or GPC signals. Our Services respond consistent with applicable law and our cookie/consent tooling; certain functionality may require essential cookies.\"}]]}]\n10:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"13) Third-Party Sites & Services\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"Our sites and products may link to or integrate with third-party services. Their privacy practices are governed by their own policies, not this one. Review those policies before enabling integrations.\"}]]}]\n11:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"14) Changes to This Policy\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"We may update this Policy to reflect changes in technology, law, or our Services. If we make material changes, we'll post the updated Policy and adjust the \\\"Last updated\\\" date; when required, we'll provide additional notice or seek consent. Continued use of the Services after the effective date means you accept the changes.\"}]]}]\n12:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"15) Contact Us\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-foreground/80\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Email:\"}],\" \",[\"$\",\"a\",null,{\"href\":\"mailto:privacy@navio.example\",\"className\":\"text-primary hover:underline\",\"children\":\"privacy@navio.example\"}]]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Mail:\"}],\" Navio, Inc., Attn: Privacy, [insert address]\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Security reports:\"}],\" \",[\"$\",\"a\",null,{\"href\":\"mailto:security@navio.example\",\"className\":\"text-primary hover:underline\",\"children\":\"security@navio.example\"}]]}]]}]]}]\n13:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-6\",\"children\":\"16) Region-Specific Disclosures\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold text-foreground mb-3\",\"children\":\"EEA/UK/Switzerland\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-foreground/80\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Controller:\"}],\" For Navio website/sales/support data: Navio, Inc. For in-app End-User data, the relevant customer is controller and Navio acts as processor.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Legal bases:\"}],\" contract, legitimate interests, consent (where required), legal obligations.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Transfers:\"}],\" safeguarded by SCCs or equivalent measures; additional technical/organizational measures apply.\"]}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-semibold text-foreground mb-3\",\"children\":\"California (CPRA) & certain U.S. states\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-foreground/80\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"We act as a \",[\"$\",\"strong\",null,{\"children\":\"service provider/processor\"}],\" to our customers for in-app data. For our own site/account data, we act as a \",[\"$\",\"strong\",null,{\"children\":\"business/controller\"}],\".\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":\"We do not sell or share personal information for cross-context behavioral advertising as defined by CPRA; if this changes, we will provide required notices and opt-out mechanisms.\"}]]}]]}]]}]]}]\n14:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"17) Data Subject / Consumer Requests\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed mb-4\",\"children\":\"To exercise rights:\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-foreground/80\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"End Users:\"}],\" contact the customer whose app you were using; we'll assist them in fulfilling your request.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Website/prospect/account data:\"}],\" contact Navio at \",[\"$\",\"a\",null,{\"href\":\"mailto:privacy@navio.example\",\"className\":\"text-primary hover:underline\",\"children\":\"privacy@navio.example\"}],\". We may need to verify your identity or authority. If we cannot comply due to legal or contractual limits, we'll explain why where appropriate.\"]}]]}]]}]\n15:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"18) Data Processing Addendum (DPA)\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"For customers subject to data protection laws (e.g., GDPR/UK GDPR), our DPA (including applicable transfer mechanisms) becomes part of your agreement when executed or referenced in your order.\"}]]}]\n16:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"19) Sub-processors\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground/80 leading-relaxed\",\"children\":\"We use vetted service providers to process data on our behalf and remain responsible for their performance. We maintain a current list upon request and will provide advance notice of material changes as required.\"}]]}]\n17:[\"$\",\"section\",null,{\"className\":\"pt-4 border-t border-border\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-extrabold text-foreground mb-4\",\"children\":\"20) How Our Practices Map to Your Expectations (Quick Read)\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3 text-foreground/80\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"What we collect:\"}],\" account/contact info, usage/device data, in-app interaction data, and data from integrations you enable.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Why:\"}],\" to run guidance/Autopilot, analytics/insights, support, security, and product improvement.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Choices:\"}],\" manage cookies, marketing preferences, and submit rights requests.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Security:\"}],\" encryption in transit/at rest, access controls, rate limiting, and incident response.\"]}]]}]]}]\n18:[\"$\",\"$L1c\",null,{}]\n19:[\"$\",\"$L1d\",null,{\"children\":[\"$L1e\",[\"$\",\"$L1f\",null,{\"promise\":\"$@20\"}]]}]\n1a:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L21\",null,{\"children\":\"$L22\"}],null],[\"$\",\"$L23\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$24\",null,{\"fallback\":null,\"children\":\"$L25\"}]}]}]]}]\n22:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n1e:null\n26:I[38175,[],\"IconMark\"]\n20:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Navio - Software, effortless\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"AI expert that lives in your product, guiding users and automa