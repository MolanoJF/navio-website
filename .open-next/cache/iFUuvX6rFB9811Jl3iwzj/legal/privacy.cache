{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/legal/layout,_N_T_/legal/privacy/layout,_N_T_/legal/privacy/page,_N_T_/legal/privacy"}},"html":"<!DOCTYPE html><!--iFUuvX6rFB9811Jl3iwzj--><html lang=\"en\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" href=\"/Navio-L.svg\"/><link rel=\"stylesheet\" href=\"/_next/static/css/45662c377552c4de.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-95e80b8b8cf9dab3.js\"/><script src=\"/_next/static/chunks/4bd1b696-9911af18dede28aa.js\" async=\"\"></script><script src=\"/_next/static/chunks/964-42be1c1b65719424.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-c1f0d2d10ecd6c61.js\" async=\"\"></script><script src=\"/_next/static/chunks/578-9370796a8416175a.js\" async=\"\"></script><script src=\"/_next/static/chunks/874-731ee3ee27bcf85c.js\" async=\"\"></script><script src=\"/_next/static/chunks/5-72c20c2d9d2aecdb.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/legal/privacy/page-077b4d2d8291a54d.js\" async=\"\"></script><title>Navio - Software, effortless</title><meta name=\"description\" content=\"AI expert that lives in your product, guiding users and automating tasks.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><link rel=\"icon\" href=\"/Navio-D.svg\" media=\"(prefers-color-scheme: light)\"/><link rel=\"icon\" href=\"/Navio-L.svg\" media=\"(prefers-color-scheme: dark)\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__variable_73ee6c\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-background\"><div class=\"fixed top-0 left-0 right-0 z-50\"><div class=\"sticky inset-x-0 z-40 w-full top-0\"><div class=\"relative z-[60] mx-auto hidden w-full flex-row items-center justify-between self-start bg-transparent px-3 py-2 lg:flex dark:bg-transparent\" style=\"max-width:100%;border-radius:0px\"><div class=\"flex-shrink-0 z-20\"><a class=\"flex items-center space-x-2 hover:opacity-40 transition-opacity\" href=\"/\"><img src=\"/Navio-L.svg\" alt=\"Navio Logo\" class=\"h-6 lg:h-8 w-auto\"/><span class=\"text-base sm:text-lg lg:text-xl text-foreground tracking-tight\">Navio</span></a></div><div class=\"absolute inset-0 hidden flex-1 flex-row items-center justify-center space-x-2 text-base sm:text-lg lg:text-xl text-foreground/80 leading-relaxed hover:text-foreground lg:flex lg:space-x-2\"><a class=\"relative px-4 py-2 text-foreground/80 hover:text-foreground\" href=\"/#what\"><span class=\"relative z-20\">Demo</span></a><a class=\"relative px-4 py-2 text-foreground/80 hover:text-foreground\" href=\"/#features\"><span class=\"relative z-20\">Features</span></a><a class=\"relative px-4 py-2 text-foreground/80 hover:text-foreground\" href=\"/#faq\"><span class=\"relative z-20\">FAQ</span></a></div><div class=\"flex items-center space-x-3\"><a href=\"https://cal.com/navio-owdjpk/navio-demo\" class=\"rounded-md button bg-white text-black relative cursor-pointer hover:-translate-y-0.5 transition duration-200 text-center shadow-[0_0_24px_rgba(34,_42,_53,_0.06),_0_1px_1px_rgba(0,_0,_0,_0.05),_0_0_0_1px_rgba(34,_42,_53,_0.04),_0_0_4px_rgba(34,_42,_53,_0.08),_0_16px_68px_rgba(47,_48,_55,_0.05),_0_1px_0_rgba(255,_255,_255,_0.1)_inset] hidden sm:inline-flex px-4 py-2 text-sm font-medium btn-3d\">Book a Demo</a></div></div><div class=\"relative z-50 mx-auto flex w-full flex-col items-center justify-between bg-transparent px-0 py-2 lg:hidden\" style=\"max-width:100%;border-radius:0px;padding-left:0px;padding-right:0px\"><div class=\"flex w-full flex-row items-center justify-between\"><div class=\"flex-shrink-0 z-20\"><a class=\"flex items-center space-x-2 hover:opacity-80 transition-opacity\" href=\"/\"><img src=\"/Navio-L.svg\" alt=\"Navio Logo\" class=\"h-6 w-auto\"/><span class=\"text-base sm:text-lg lg:text-xl text-foreground tracking-tight\">Navio</span></a></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"tabler-icon tabler-icon-menu-2 text-black dark:text-white\"><path d=\"M4 6l16 0\"></path><path d=\"M4 12l16 0\"></path><path d=\"M4 18l16 0\"></path></svg></div></div></div></div><div class=\"container mx-auto px-4 md:px-6 2xl:max-w-[1400px] py-24 lg:py-32\"><div class=\"max-w-4xl mx-auto mb-12\"><h1 class=\"text-4xl md:text-5xl font-extrabold text-foreground mb-4 tracking-tight\">Privacy Policy</h1><p class=\"text-lg text-muted-foreground\">Last updated: November 7, 2025</p><p class=\"mt-6 text-foreground/80 leading-relaxed\">We take your privacy seriously. This Privacy Policy explains how Navio collects, uses, shares, and protects your personal information.</p></div><article class=\"max-w-4xl mx-auto space-y-10\"><section><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">1) Scope &amp; Roles</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>Who this covers.</strong> This Policy applies to (a) visitors to our sites, (b) prospects and customers, and (c) end users who interact with Navio&#x27;s in-app widget/agent on our customers&#x27; apps (&quot;End Users&quot;).</li><li class=\"leading-relaxed\"><strong>Controller vs. processor.</strong> For our own website, sales, support, and account data, Navio is a <strong>data controller</strong>. When customers deploy our snippet/agent inside their product, Navio generally acts as a <strong>data processor/service provider</strong> on their instructions and contract; the customer&#x27;s own privacy notice governs what they collect from End Users in their app.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-6\">2) Information We Collect</h2><div class=\"space-y-6\"><div><h3 class=\"text-xl font-semibold text-foreground mb-3\">A) Information you provide</h3><p class=\"text-foreground/80 leading-relaxed\">Account/contact details (name, email, role), billing info, messages, and content you upload or connect (e.g., product docs, release notes, support content).</p></div><div><h3 class=\"text-xl font-semibold text-foreground mb-3\">B) Information we collect automatically</h3><ul class=\"space-y-2 text-foreground/80\"><li class=\"leading-relaxed\"><strong>Usage &amp; device data.</strong> IP address, identifiers, browser/OS, pages and actions, session metadata, event timestamps, and diagnostics/logs.</li><li class=\"leading-relaxed\"><strong>In-app interaction data.</strong> UI elements Navio highlights, steps shown, clicks/actions executed by Autopilot (when enabled), success/failure events, and performance/latency metrics.</li><li class=\"leading-relaxed\"><strong>Cookies &amp; similar tech.</strong> To run the widget, keep you signed in, measure usage, and improve the product (see &quot;Cookies&quot; below).</li></ul></div><div><h3 class=\"text-xl font-semibold text-foreground mb-3\">C) From integrations &amp; third parties (optional)</h3><p class=\"text-foreground/80 leading-relaxed\">If you connect tools (e.g., Zendesk/Intercom/help center/analytics), we receive the data you authorize through those integrations to surface guidance and context. Your use of those tools is governed by their policies.</p></div><div><h3 class=\"text-xl font-semibold text-foreground mb-3\">D) De-identified/aggregated data</h3><p class=\"text-foreground/80 leading-relaxed\">We may create de-identified or aggregated datasets for benchmarking, trends, and product improvement; we do not attempt to re-identify individuals from such data.</p></div></div></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">3) How We Use Information</h2><ul class=\"space-y-2 text-foreground/80 mb-4\"><li class=\"leading-relaxed\">Provide, secure, maintain, and improve the Services (including the widget, guidance, Autopilot, analytics, and dashboards).</li><li class=\"leading-relaxed\">Configure and operate flows you define (e.g., role-based rules, approvals, rate limits), surface contextual help, and produce insights like intent heatmaps and drop-off points.</li><li class=\"leading-relaxed\">Communicate with you (product updates, support, security, billing) and run core business operations (fraud prevention, audits, compliance).</li><li class=\"leading-relaxed\">Develop new features, quality assurance, and research (including aggregated analysis).</li><li class=\"leading-relaxed\">With your consent, send marketing; you can opt out anytime.</li></ul><div class=\"bg-accent/5 border border-accent/20 rounded-lg p-4\"><p class=\"text-foreground/80\"><strong>Legal bases (EEA/UK/Switzerland):</strong> We rely on performance of contract, legitimate interests (e.g., to secure and improve the Services), consent (where required, e.g., certain cookies/marketing), and legal obligations.</p></div></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">4) Product-Specific Notes (Guidance &amp; Autopilot)</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>Guidance.</strong> We process UI context, events, and your connected content to show step-by-step instructions and in-app help.</li><li class=\"leading-relaxed\"><strong>Autopilot (optional).</strong> When you enable it, Navio executes permitted clicks/navigation and logs execution metadata for observability and audit. Customers control scope, permissions, and approvals in their environment.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">5) Cookies &amp; Similar Technologies</h2><p class=\"text-foreground/80 leading-relaxed\">We use cookies, local storage, and similar technologies to run core features (authentication, session continuity), remember preferences, and analyze usage/performance. Where required, we&#x27;ll request consent and provide choices (e.g., cookie banner). You can manage cookies via your browser; blocking some cookies may impact functionality.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">6) How We Share Information</h2><p class=\"text-foreground/80 leading-relaxed mb-4\">We share information with:</p><ul class=\"space-y-3 text-foreground/80 mb-4\"><li class=\"leading-relaxed\"><strong>Service providers/subprocessors</strong> (cloud hosting, security, analytics, email, customer support) under contracts requiring confidentiality and appropriate safeguards.</li><li class=\"leading-relaxed\"><strong>Integrations you enable</strong> (help desks, analytics, knowledge sources) as instructed by you.</li><li class=\"leading-relaxed\"><strong>Professional advisors</strong> and <strong>law enforcement</strong> when required by law or to protect rights, safety, and security.</li><li class=\"leading-relaxed\"><strong>Corporate transactions</strong> (merger, acquisition) with continuity of protections.</li></ul><p class=\"text-foreground/80 leading-relaxed\">We also disclose <strong>aggregated/de-identified</strong> insights that do not identify individuals.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">7) International Transfers</h2><p class=\"text-foreground/80 leading-relaxed\">We may transfer, store, and process information in countries outside your own. When required, we use appropriate safeguards (e.g., Standard Contractual Clauses and comparable mechanisms) and implement technical/organizational measures to protect data during transfer and at rest/in transit.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">8) Security</h2><p class=\"text-foreground/80 leading-relaxed\">We implement technical and organizational measures to protect information, including industry-standard encryption in transit and at rest, access controls/roles, rate limiting/abuse protections, and vulnerability management. No system is 100% secure; we maintain programs to prevent, detect, and respond to incidents.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">9) Data Retention</h2><p class=\"text-foreground/80 leading-relaxed\">We retain personal information for as long as needed to provide the Services, comply with legal obligations, resolve disputes, enforce agreements, and for legitimate business needs. Customers can configure or request export/deletion consistent with our retention practices and applicable law.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">10) Your Privacy Rights</h2><p class=\"text-foreground/80 leading-relaxed mb-4\">Depending on where you live, you may have rights to:</p><ul class=\"space-y-2 text-foreground/80 mb-4\"><li class=\"leading-relaxed\">Access, correct, update, or delete your personal information;</li><li class=\"leading-relaxed\">Object to or restrict processing;</li><li class=\"leading-relaxed\">Port your data;</li><li class=\"leading-relaxed\">Withdraw consent where processing is based on consent;</li><li class=\"leading-relaxed\">Lodge a complaint with a supervisory authority.</li></ul><p class=\"text-foreground/80 leading-relaxed mb-4\">End Users should direct requests to the relevant <strong>customer</strong> (the controller for in-app data); we&#x27;ll support them as the processor. You can also contact Navio for our own controller data.</p><div class=\"bg-accent/5 border border-accent/20 rounded-lg p-4\"><p class=\"text-foreground/80\"><strong>U.S. state laws (e.g., CA/VA/CO/CT/UT):</strong> If these apply, you may have additional rights regarding access, deletion, correction, and opt-out of &quot;sale,&quot; &quot;sharing,&quot; or targeted advertising. We do not sell personal information as defined by these laws, and we honor applicable opt-out rights. (We provide mechanisms to limit cross-context behavioral advertising where required.)</p></div></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">11) Children&#x27;s Privacy</h2><p class=\"text-foreground/80 leading-relaxed\">The Services are not directed to children under 16, and we do not knowingly collect personal information from them. If we learn we&#x27;ve collected such data, we&#x27;ll delete it.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">12) Do Not Track &amp; Global Privacy Control</h2><p class=\"text-foreground/80 leading-relaxed\">Some browsers offer &quot;Do Not Track&quot; or GPC signals. Our Services respond consistent with applicable law and our cookie/consent tooling; certain functionality may require essential cookies.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">13) Third-Party Sites &amp; Services</h2><p class=\"text-foreground/80 leading-relaxed\">Our sites and products may link to or integrate with third-party services. Their privacy practices are governed by their own policies, not this one. Review those policies before enabling integrations.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">14) Changes to This Policy</h2><p class=\"text-foreground/80 leading-relaxed\">We may update this Policy to reflect changes in technology, law, or our Services. If we make material changes, we&#x27;ll post the updated Policy and adjust the &quot;Last updated&quot; date; when required, we&#x27;ll provide additional notice or seek consent. Continued use of the Services after the effective date means you accept the changes.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">15) Contact Us</h2><ul class=\"space-y-2 text-foreground/80\"><li class=\"leading-relaxed\"><strong>Email:</strong> <a href=\"mailto:privacy@navio.example\" class=\"text-primary hover:underline\">privacy@navio.example</a></li><li class=\"leading-relaxed\"><strong>Mail:</strong> Navio, Inc., Attn: Privacy, [insert address]</li><li class=\"leading-relaxed\"><strong>Security reports:</strong> <a href=\"mailto:security@navio.example\" class=\"text-primary hover:underline\">security@navio.example</a></li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-6\">16) Region-Specific Disclosures</h2><div class=\"space-y-6\"><div><h3 class=\"text-xl font-semibold text-foreground mb-3\">EEA/UK/Switzerland</h3><ul class=\"space-y-2 text-foreground/80\"><li class=\"leading-relaxed\"><strong>Controller:</strong> For Navio website/sales/support data: Navio, Inc. For in-app End-User data, the relevant customer is controller and Navio acts as processor.</li><li class=\"leading-relaxed\"><strong>Legal bases:</strong> contract, legitimate interests, consent (where required), legal obligations.</li><li class=\"leading-relaxed\"><strong>Transfers:</strong> safeguarded by SCCs or equivalent measures; additional technical/organizational measures apply.</li></ul></div><div><h3 class=\"text-xl font-semibold text-foreground mb-3\">California (CPRA) &amp; certain U.S. states</h3><ul class=\"space-y-2 text-foreground/80\"><li class=\"leading-relaxed\">We act as a <strong>service provider/processor</strong> to our customers for in-app data. For our own site/account data, we act as a <strong>business/controller</strong>.</li><li class=\"leading-relaxed\">We do not sell or share personal information for cross-context behavioral advertising as defined by CPRA; if this changes, we will provide required notices and opt-out mechanisms.</li></ul></div></div></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">17) Data Subject / Consumer Requests</h2><p class=\"text-foreground/80 leading-relaxed mb-4\">To exercise rights:</p><ul class=\"space-y-2 text-foreground/80\"><li class=\"leading-relaxed\"><strong>End Users:</strong> contact the customer whose app you were using; we&#x27;ll assist them in fulfilling your request.</li><li class=\"leading-relaxed\"><strong>Website/prospect/account data:</strong> contact Navio at <a href=\"mailto:privacy@navio.example\" class=\"text-primary hover:underline\">privacy@navio.example</a>. We may need to verify your identity or authority. If we cannot comply due to legal or contractual limits, we&#x27;ll explain why where appropriate.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">18) Data Processing Addendum (DPA)</h2><p class=\"text-foreground/80 leading-relaxed\">For customers subject to data protection laws (e.g., GDPR/UK GDPR), our DPA (including applicable transfer mechanisms) becomes part of your agreement when executed or referenced in your order.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">19) Sub-processors</h2><p class=\"text-foreground/80 leading-relaxed\">We use vetted service providers to process data on our behalf and remain responsible for their performance. We maintain a current list upon request and will provide advance notice of material changes as required.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">20) How Our Practices Map to Your Expectations (Quick Read)</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>What we collect:</strong> account/contact info, usage/device data, in-app interaction data, and data from integrations you enable.</li><li class=\"leading-relaxed\"><strong>Why:</strong> to run guidance/Autopilot, analytics/insights, support, security, and product improvement.</li><li class=\"leading-relaxed\"><strong>Choices:</strong> manage cookies, marketing preferences, and submit rights requests.</li><li class=\"leading-relaxed\"><strong>Security:</strong> encryption in transit/at rest, access controls, rate limiting, and incident response.</li></ul></section></article></div><footer class=\"my-8\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-0\"><div class=\"flex flex-col lg:flex-row justify-between\"><div><div class=\"mb-2\"><h3 class=\"text-4xl font-bold text-foreground tracking-tight mb-4 flex items-center gap-2\"><img src=\"/Navio-L.svg\" alt=\"Navio Logo\" class=\"w-12 h-12\"/>Navio</h3><p class=\"text-foreground/70 text-base leading-relaxed max-w-md mb-6\">The intelligent layer your app, helping users get guidance or automate entire workflows.</p><div class=\"flex items-center gap-4\"><a href=\"https://x.com/Navio_bot\" class=\"text-foreground/60 hover:text-foreground transition-colors duration-200\" aria-label=\"X\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"></path></svg></a><a href=\"https://www.linkedin.com/company/naviobot\" class=\"text-foreground/60 hover:text-foreground transition-colors duration-200\" aria-label=\"LinkedIn\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z\"></path></svg></a></div></div></div><div class=\"grid grid-cols-3 gap-6\"><div class=\"space-y-4\"><h4 class=\"text-lg font-semibold text-foreground\">Product</h4><ul class=\"space-y-3\"><li><a class=\"text-foreground/70 hover:text-foreground transition-colors duration-200\" href=\"/#How\">Demo</a></li><li><a href=\"#Resources\" class=\"text-foreground/70 hover:text-foreground transition-colors duration-200\">Features</a></li></ul></div><div class=\"space-y-4\"><h4 class=\"text-lg font-semibold text-foreground\">Company</h4><ul class=\"space-y-3\"><li><a class=\"text-foreground/70 hover:text-foreground transition-colors duration-200\" href=\"/security\">Security</a></li><li><a href=\"https://cal.com/navio-owdjpk/navio-demo\" class=\"text-foreground/70 hover:text-foreground transition-colors duration-200\">Contact</a></li></ul></div><div class=\"space-y-4\"><h4 class=\"text-lg font-semibold text-foreground\">Resources</h4><ul class=\"space-y-3\"><li><a class=\"text-foreground/70 hover:text-foreground transition-colors duration-200\" href=\"/legal/privacy\">Privacy</a></li><li><a class=\"text-foreground/70 hover:text-foreground transition-colors duration-200\" href=\"/legal/terms\">Terms</a></li></ul></div></div></div></div></footer></main><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-95e80b8b8cf9dab3.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[87555,[],\\\"\\\"]\\n3:I[31295,[],\\\"\\\"]\\n4:I[45241,[\\\"578\\\",\\\"static/chunks/578-9370796a8416175a.js\\\",\\\"874\\\",\\\"static/chunks/874-731ee3ee27bcf85c.js\\\",\\\"5\\\",\\\"static/chunks/5-72c20c2d9d2aecdb.js\\\",\\\"567\\\",\\\"static/chunks/app/legal/privacy/page-077b4d2d8291a54d.js\\\"],\\\"default\\\"