{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/legal/layout,_N_T_/legal/terms/layout,_N_T_/legal/terms/page,_N_T_/legal/terms"}},"html":"<!DOCTYPE html><!--Met6phaSk0NcAlDkLNSrP--><html lang=\"en\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" href=\"/Navio-L.svg\"/><link rel=\"stylesheet\" href=\"/_next/static/css/45662c377552c4de.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-95e80b8b8cf9dab3.js\"/><script src=\"/_next/static/chunks/4bd1b696-9911af18dede28aa.js\" async=\"\"></script><script src=\"/_next/static/chunks/964-42be1c1b65719424.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-c1f0d2d10ecd6c61.js\" async=\"\"></script><script src=\"/_next/static/chunks/578-9370796a8416175a.js\" async=\"\"></script><script src=\"/_next/static/chunks/874-731ee3ee27bcf85c.js\" async=\"\"></script><script src=\"/_next/static/chunks/5-72c20c2d9d2aecdb.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/legal/terms/page-077b4d2d8291a54d.js\" async=\"\"></script><title>Navio - Software, effortless</title><meta name=\"description\" content=\"AI expert that lives in your product, guiding users and automating tasks.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><link rel=\"icon\" href=\"/Navio-D.svg\" media=\"(prefers-color-scheme: light)\"/><link rel=\"icon\" href=\"/Navio-L.svg\" media=\"(prefers-color-scheme: dark)\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__variable_73ee6c\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-background\"><div class=\"fixed top-0 left-0 right-0 z-50\"><div class=\"sticky inset-x-0 z-40 w-full top-0\"><div class=\"relative z-[60] mx-auto hidden w-full flex-row items-center justify-between self-start bg-transparent px-3 py-2 lg:flex dark:bg-transparent\" style=\"max-width:100%;border-radius:0px\"><div class=\"flex-shrink-0 z-20\"><a class=\"flex items-center space-x-2 hover:opacity-40 transition-opacity\" href=\"/\"><img src=\"/Navio-L.svg\" alt=\"Navio Logo\" class=\"h-6 lg:h-8 w-auto\"/><span class=\"text-base sm:text-lg lg:text-xl text-foreground tracking-tight\">Navio</span></a></div><div class=\"absolute inset-0 hidden flex-1 flex-row items-center justify-center space-x-2 text-base sm:text-lg lg:text-xl text-foreground/80 leading-relaxed hover:text-foreground lg:flex lg:space-x-2\"><a class=\"relative px-4 py-2 text-foreground/80 hover:text-foreground\" href=\"/#what\"><span class=\"relative z-20\">Demo</span></a><a class=\"relative px-4 py-2 text-foreground/80 hover:text-foreground\" href=\"/#features\"><span class=\"relative z-20\">Features</span></a><a class=\"relative px-4 py-2 text-foreground/80 hover:text-foreground\" href=\"/#faq\"><span class=\"relative z-20\">FAQ</span></a></div><div class=\"flex items-center space-x-3\"><a href=\"https://cal.com/navio-owdjpk/navio-demo\" class=\"rounded-md button bg-white text-black relative cursor-pointer hover:-translate-y-0.5 transition duration-200 text-center shadow-[0_0_24px_rgba(34,_42,_53,_0.06),_0_1px_1px_rgba(0,_0,_0,_0.05),_0_0_0_1px_rgba(34,_42,_53,_0.04),_0_0_4px_rgba(34,_42,_53,_0.08),_0_16px_68px_rgba(47,_48,_55,_0.05),_0_1px_0_rgba(255,_255,_255,_0.1)_inset] hidden sm:inline-flex px-4 py-2 text-sm font-medium btn-3d\">Book a Demo</a></div></div><div class=\"relative z-50 mx-auto flex w-full flex-col items-center justify-between bg-transparent px-0 py-2 lg:hidden\" style=\"max-width:100%;border-radius:0px;padding-left:0px;padding-right:0px\"><div class=\"flex w-full flex-row items-center justify-between\"><div class=\"flex-shrink-0 z-20\"><a class=\"flex items-center space-x-2 hover:opacity-80 transition-opacity\" href=\"/\"><img src=\"/Navio-L.svg\" alt=\"Navio Logo\" class=\"h-6 w-auto\"/><span class=\"text-base sm:text-lg lg:text-xl text-foreground tracking-tight\">Navio</span></a></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"tabler-icon tabler-icon-menu-2 text-black dark:text-white\"><path d=\"M4 6l16 0\"></path><path d=\"M4 12l16 0\"></path><path d=\"M4 18l16 0\"></path></svg></div></div></div></div><div class=\"container mx-auto px-4 md:px-6 2xl:max-w-[1400px] py-24 lg:py-32\"><div class=\"max-w-4xl mx-auto mb-12\"><h1 class=\"text-4xl md:text-5xl font-bold text-foreground mb-4 tracking-tight\">Terms of Service</h1><p class=\"text-lg text-muted-foreground\">Last updated: November 7, 2025</p><p class=\"mt-6 text-foreground/80 leading-relaxed\">These Terms of Service (&quot;Terms&quot;) are a binding agreement between Navio, Inc. (&quot;Navio,&quot; &quot;we,&quot; &quot;us,&quot; or &quot;our&quot;) and the person or entity agreeing to them (&quot;Customer,&quot; &quot;you,&quot; or &quot;your&quot;). By creating an account, clicking &quot;Accept,&quot; installing the Navio code snippet, or using the Services, you agree to these Terms.</p></div><article class=\"max-w-4xl mx-auto space-y-10\"><div class=\"bg-accent/5 border border-accent/20 rounded-lg p-6 mb-8\"><p class=\"text-foreground/80 leading-relaxed\">If you accept on behalf of an organization, you represent that you have authority to bind that organization. If you don&#x27;t agree, do not use the Services. Navio may update these Terms periodically by posting a revised version with an updated &quot;Last updated&quot; date. Continued use constitutes acceptance of the changes.</p></div><section><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">1) Definitions</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) &quot;Services&quot;</strong> means Navio&#x27;s hosted software and components (including the in-app widget, guidance, Autopilot, analytics, dashboards, SDKs/snippets, and related websites).</li><li class=\"leading-relaxed\"><strong>b) &quot;Customer Properties&quot;</strong> means your websites, web apps, or other interfaces where you deploy the Navio agent/snippet.</li><li class=\"leading-relaxed\"><strong>c) &quot;Customer Data&quot;</strong> means data you or your End Users submit to or through the Services (e.g., events, UI context, content you ingest).</li><li class=\"leading-relaxed\"><strong>d) &quot;Usage Data&quot;</strong> means telemetry, logs, and aggregated/anonymous data about use of the Services.</li><li class=\"leading-relaxed\"><strong>e) &quot;End Users&quot;</strong> means users of your Customer Properties.</li><li class=\"leading-relaxed\"><strong>f) &quot;Order&quot;</strong> means an order form, online plan selection, or similar specifying plan, term, and pricing.</li><li class=\"leading-relaxed\"><strong>g) &quot;Documentation&quot;</strong> means Navio&#x27;s published docs and policies referenced in an Order.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">2) Accounts; Trials; Beta</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) Accounts.</strong> Registration information must be accurate and kept current. You&#x27;re responsible for credentials and all activity under your account.</li><li class=\"leading-relaxed\"><strong>b) Free Trials.</strong> Trial use is provided &quot;as is&quot; and may be rate-limited or feature-limited.</li><li class=\"leading-relaxed\"><strong>c) Beta/Preview.</strong> We may offer pre-release features (&quot;Beta&quot;). Betas may be changed or discontinued at any time and are provided without warranties or support.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">3) Access and Use</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) License.</strong> Subject to these Terms and your Order, Navio grants you a limited, non-exclusive, non-transferable license during the Term to access and use the Services for your internal business purposes.</li><li class=\"leading-relaxed\"><strong>b) Deployment Code.</strong> The Services include the right to deploy Navio&#x27;s snippet/agent on Customer Properties to enable in-app guidance, automation, and data collection for use with the Services.</li><li class=\"leading-relaxed\"><strong>c) Restrictions.</strong> You will not (and will not permit others to): (i) reverse engineer or attempt to access source code; (ii) bypass security or usage limits; (iii) resell or provide the Services to third parties except as expressly permitted; (iv) use the Services to develop a competing product; (v) remove proprietary notices; or (vi) use the Services for unlawful, harmful, or high-risk activities (see 7).</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">4) Customer Responsibilities</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) Permissions and Consents.</strong> You are responsible for obtaining all necessary rights, consents, and notices to lawfully deploy the Navio agent on Customer Properties and process Customer Data (including End-User disclosures and cookie/analytics consents where required).</li><li class=\"leading-relaxed\"><strong>b) Configuration and Safeguards.</strong> You control when and where Autopilot is allowed to run. You must configure role-based rules, approvals, guardrails, and rate limits that align with your policies, and test flows in a safe environment before production.</li><li class=\"leading-relaxed\"><strong>c) Third-Party Services.</strong> If you enable connectors (e.g., Zendesk, Intercom, analytics), your use of those services is governed by their terms; Navio is not responsible for their acts or omissions.</li><li class=\"leading-relaxed\"><strong>d) Data Accuracy.</strong> You are responsible for the accuracy, quality, and legality of Customer Data and how you acquired it.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">5) Acceptable Use</h2><p class=\"text-foreground/80 leading-relaxed\">You will not use the Services to: (a) violate laws; (b) infringe intellectual property or privacy rights; (c) upload malicious code; (d) attempt unauthorized access; (e) perform or facilitate denial-of-service; (f) process sensitive data categories unless permitted in an Order and compliant with applicable law; (g) operate life-support, safety-critical, or other high-risk systems where failure could lead to death, personal injury, or severe damage; or (h) generate spam, deceptive practices, or illegal surveillance.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">6) Data; Privacy; Security</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) Customer Data.</strong> Between the parties, you own Customer Data. You grant Navio a non-exclusive, worldwide, royalty-free license to host, copy, process, transmit, and display Customer Data solely to provide, secure, and improve the Services as permitted by these Terms and our Privacy Notice (and, if applicable, a DPA). This license does not transfer ownership of Customer Data.</li><li class=\"leading-relaxed\"><strong>b) Usage Data.</strong> Navio may generate, use, and disclose Usage Data (including aggregated or de-identified data) to operate, analyze, secure, and improve the Services, and for benchmarking and industry insights, provided no Customer Data is disclosed in identifiable form.</li><li class=\"leading-relaxed\"><strong>c) Data Processing Addendum.</strong> If you are subject to Data Protection Laws (e.g., GDPR/UK GDPR), our Data Processing Addendum (&quot;DPA&quot;) forms part of these Terms when executed or referenced in an Order.</li><li class=\"leading-relaxed\"><strong>d) Security.</strong> Navio will implement appropriate technical and organizational measures designed to protect Customer Data from unauthorized access, use, alteration, or disclosure.</li><li class=\"leading-relaxed\"><strong>e) Subprocessors.</strong> You authorize Navio to use subprocessors to provide the Services. Navio remains responsible for their performance and will maintain a list upon request.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">7) Product-Specific Terms (Guidance and Autopilot)</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) Guidance.</strong> The in-app guidance feature provides contextual instructions and UI highlights based on your configuration and content. You remain responsible for any instructions shown to End Users.</li><li class=\"leading-relaxed\"><strong>b) Autopilot.</strong> When enabled, Autopilot can navigate, click, and execute steps inside your Customer Properties or connected tools according to your configured rules/approvals. You designate which actions are permitted and under what conditions; Navio acts as your service provider to carry out those permitted actions. You are responsible for outcomes of authorized actions within your systems, rate limits, approvals, and any required audit or change-management processes.</li><li class=\"leading-relaxed\"><strong>c) Audit Trails.</strong> The Services may record execution logs and metadata for observability and troubleshooting. You should export and retain logs needed for your compliance program.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">8) Fees; Taxes</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) Fees.</strong> You agree to pay the fees specified in the Order. Fees are invoiced or charged in advance and are non-cancelable and non-refundable except as expressly provided.</li><li class=\"leading-relaxed\"><strong>b) Overages.</strong> If usage exceeds plan limits, overage fees may apply at then-current rates.</li><li class=\"leading-relaxed\"><strong>c) Taxes.</strong> Fees are exclusive of taxes. You are responsible for sales, use, VAT/GST, and similar taxes (excluding taxes based on Navio&#x27;s income).</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">9) Support; Service Levels</h2><p class=\"text-foreground/80 leading-relaxed\">If your plan includes support or service levels, they are described in your Order or Documentation. Professional services (e.g., onboarding, implementation) are provided as specified in an Order and may be subject to separate terms.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">10) Intellectual Property</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) Ownership.</strong> Navio owns the Services, Documentation, and all related IP. No rights are granted except as expressly stated.</li><li class=\"leading-relaxed\"><strong>b) Feedback.</strong> If you provide feedback or suggestions, you grant Navio a perpetual, irrevocable, worldwide license to use them without restriction or compensation.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">11) Confidentiality</h2><p class=\"text-foreground/80 leading-relaxed\">Each party may access the other&#x27;s confidential information and will use it only to perform under these Terms and protect it with reasonable care. Exclusions apply for information that is public, already known, independently developed, or rightfully disclosed by a third party.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">12) Warranties; Disclaimers</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) Mutual.</strong> Each party represents it has authority to enter into these Terms.</li><li class=\"leading-relaxed\"><strong>b) Navio.</strong> We warrant that during a paid subscription the Services will perform materially in accordance with the Documentation. Your exclusive remedy is re-performance of the Services, or if we cannot cure, a pro-rata refund for the affected period.</li><li class=\"leading-relaxed\"><strong>c) Disclaimers.</strong> Except as expressly provided, the Services, Betas, and trials are provided &quot;as is.&quot; Navio disclaims all other warranties, including implied warranties of merchantability, fitness for a particular purpose, non-infringement, and uninterrupted or error-free operation.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">13) Indemnification</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) By Navio.</strong> We will defend and indemnify you against third-party claims alleging that the Services infringe a U.S. patent, copyright, or trademark, or misappropriate a trade secret, and pay finally awarded damages and reasonable defense costs, provided you promptly notify us and cooperate. We may repair, replace, or procure rights; if not feasible, we may terminate the affected Services with a pro-rata refund.</li><li class=\"leading-relaxed\"><strong>b) By Customer.</strong> You will defend and indemnify Navio against claims arising from (i) Customer Data, Customer Properties, or your configurations/instructions, (ii) use in violation of these Terms, or (iii) your use with third-party services or high-risk uses.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">14) Limitation of Liability</h2><p class=\"text-foreground/80 leading-relaxed\">To the maximum extent permitted by law: (a) neither party will be liable for any indirect, incidental, special, consequential, or punitive damages, or for lost profits, revenues, goodwill, or data; and (b) each party&#x27;s aggregate liability arising out of or relating to the Services will not exceed the amounts paid or payable by you to Navio for the Services giving rise to the claim during the twelve (12) months before the first event giving rise to liability. These limitations apply even if a remedy fails of its essential purpose.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">15) Term; Suspension; Termination</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) Term.</strong> These Terms start when you first accept them and continue for the subscription term in your Order, renewing per its terms unless terminated.</li><li class=\"leading-relaxed\"><strong>b) Suspension.</strong> We may suspend access immediately for non-payment, security risks, suspected violation of these Terms, or to comply with law.</li><li class=\"leading-relaxed\"><strong>c) Termination.</strong> Either party may terminate for material breach not cured within thirty (30) days after written notice. You may terminate at end of the then-current term per your Order.</li><li class=\"leading-relaxed\"><strong>d) Effect.</strong> Upon termination, your right to access the Services ends. Upon request within thirty (30) days, we will make available a copy of your Customer Data in a reasonable export format; we may then delete Customer Data per our retention policy, except where law requires retention.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">16) Modifications to the Services</h2><p class=\"text-foreground/80 leading-relaxed\">We may modify features or functionality, or discontinue components, provided that we will not materially reduce core functionality of a paid plan during the current term without providing substantially equivalent functionality or a pro-rata refund for materially affected features.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">17) Compliance; Export; Sanctions</h2><p class=\"text-foreground/80 leading-relaxed\">You will comply with all applicable laws, including privacy, anti-corruption, export control, and sanctions laws. You will not permit access to the Services from embargoed jurisdictions or to prohibited parties.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">18) Government Use</h2><p class=\"text-foreground/80 leading-relaxed\">The Services are &quot;commercial computer software&quot; and related documentation; government end users&#x27; rights are limited by these Terms and applicable law.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">19) Publicity</h2><p class=\"text-foreground/80 leading-relaxed\">We may use your name and logo to identify you as a customer on our websites and marketing materials, consistent with your brand guidelines. You may opt out with written notice.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">20) Dispute Resolution; Governing Law</h2><ul class=\"space-y-3 text-foreground/80\"><li class=\"leading-relaxed\"><strong>a) Informal Resolution.</strong> Before filing a claim, the parties will attempt to resolve disputes informally for thirty (30) days.</li><li class=\"leading-relaxed\"><strong>b) Governing Law; Venue.</strong> These Terms are governed by the laws of the State of Delaware, without regard to conflicts of law. The exclusive jurisdiction and venue for disputes is the state and federal courts located in Delaware, and the parties consent to personal jurisdiction there.</li><li class=\"leading-relaxed\"><strong>c) Injunctive Relief.</strong> Either party may seek injunctive relief for actual or threatened misuse of confidential information or intellectual property.</li></ul></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">21) Notices</h2><p class=\"text-foreground/80 leading-relaxed\">Notices to Navio must be sent to legal@navio.example and to Navio, Inc., Attn: Legal, [insert address]. We may provide notices to you via the Services, email, or your account contact.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">22) Assignment</h2><p class=\"text-foreground/80 leading-relaxed\">You may not assign these Terms without Navio&#x27;s prior written consent (not to be unreasonably withheld). Navio may assign these Terms in connection with a merger, acquisition, or sale of assets. Standard assignments/waivers/severability language applies.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">23) Force Majeure</h2><p class=\"text-foreground/80 leading-relaxed\">Neither party is liable for delays or failures due to events beyond reasonable control (e.g., internet failures, acts of God, labor disputes, governmental actions).</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">24) Entire Agreement; Order of Precedence; Waiver; Severability</h2><p class=\"text-foreground/80 leading-relaxed\">These Terms, the Order, the DPA (if applicable), and any referenced documents form the entire agreement and supersede prior agreements on the Services. If there is a conflict, the Order controls, then these Terms, then the Documentation. Failure to enforce a provision is not a waiver. If any provision is unenforceable, the remainder will remain in effect.</p></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">25) Service-Specific Annex (Landing Page Alignment)</h2><p class=\"text-foreground/80 leading-relaxed mb-4\">This annex maps features described on the website to contractual responsibilities:</p><ol class=\"list-decimal list-inside space-y-2 text-foreground/80\"><li class=\"leading-relaxed\"><strong>Real-Time Guidance.</strong> Visual highlights, field nudges, and in-app help are advisory; you remain responsible for your product decisions and End-User outcomes.</li><li class=\"leading-relaxed\"><strong>Autopilot.</strong> Executes multi-step flows under your configured role rules, approvals, and rate limits; you control scope and permissions. Navio provides observability and logs.</li><li class=\"leading-relaxed\"><strong>Custom In-App Widget; Seamless Integration.</strong> Deployment via lightweight snippet; no backend changes required for baseline features (subject to your environment).</li><li class=\"leading-relaxed\"><strong>Connect Your Knowledge.</strong> You may ingest product docs, release notes, support content, and optionally connect helpdesk/analytics. You are responsible for content quality and rights.</li><li class=\"leading-relaxed\"><strong>Insights &amp; Analytics.</strong> Intent heatmaps, drop-off points, and outcome tracking rely on events you choose to emit or enable; ensure compliance with your privacy notices and consent banners.</li></ol></section><section class=\"pt-4 border-t border-border\"><h2 class=\"text-2xl font-extrabold text-foreground mb-4\">26) Contact</h2><p class=\"text-foreground/80 leading-relaxed\">Questions about the Terms? Email <a href=\"mailto:legal@naviobot.com\" class=\"text-primary hover:underline\">legal@naviobot.com</a></p></section></article></div><footer class=\"my-8\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-0\"><div class=\"flex flex-col lg:flex-row justify-between\"><div><div class=\"mb-2\"><h3 class=\"text-4xl font-bold text-foreground tracking-tight mb-4 flex items-center gap-2\"><img src=\"/Navio-L.svg\" alt=\"Navio Logo\" class=\"w-12 h-12\"/>Navio</h3><p class=\"text-foreground/70 text-base leading-relaxed max-w-md mb-6\">The intelligent layer your app, helping users get guidance or automate entire workflows.</p><div class=\"flex items-center gap-4\"><a href=\"https://x.com/Navio_bot\" class=\"text-foreground/60 hover:text-foreground transition-colors duration-200\" aria-label=\"X\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"></path></svg></a><a href=\"https://www.linkedin.com/company/naviobot\" class=\"text-foreground/60 hover:text-foreground transition-colors duration-200\" aria-label=\"LinkedIn\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z\"></path></svg></a></div></div></div><div class=\"grid grid-cols-3 gap-6\"><div class=\"space-y-4\"><h4 class=\"text-lg font-semibold text-foreground\">Product</h4><ul class=\"space-y-3\"><li><a class=\"text-foreground/70 hover:text-foreground transition-colors duration-200\" href=\"/#How\">Demo</a></li><li><a href=\"#Resources\" class=\"text-foreground/70 hover:text-foreground transition-colors duration-200\">Features