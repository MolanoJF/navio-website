z-20\"><a class=\"text-2xl lg:text-3xl text-foreground tracking-tight hover:opacity-40 transition-opacity\" href=\"/\">NAVIO</a></div><div class=\"absolute inset-0 hidden flex-1 flex-row items-center justify-center space-x-2 text-base sm:text-lg lg:text-xl text-foreground/80 leading-relaxed hover:text-foreground lg:flex lg:space-x-2\"><a class=\"relative px-4 py-2 text-foreground/80 hover:text-foreground\" href=\"/#features\"><span class=\"relative z-20\">Product</span></a><a class=\"relative px-4 py-2 text-foreground/80 hover:text-foreground\" href=\"/pricing\"><span class=\"relative z-20\">Pricing</span></a><a class=\"relative px-4 py-2 text-foreground/80 hover:text-foreground\" href=\"#resources\"><span class=\"relative z-20\">Resources</span></a></div><div class=\"flex items-center space-x-3\"><a href=\"https://cal.com/navio-owdjpk/navio-demo\" class=\"rounded-md button bg-white text-black relative cursor-pointer hover:-translate-y-0.5 transition duration-200 text-center shadow-[0_0_24px_rgba(34,_42,_53,_0.06),_0_1px_1px_rgba(0,_0,_0,_0.05),_0_0_0_1px_rgba(34,_42,_53,_0.04),_0_0_4px_rgba(34,_42,_53,_0.08),_0_16px_68px_rgba(47,_48,_55,_0.05),_0_1px_0_rgba(255,_255,_255,_0.1)_inset] hidden sm:inline-flex px-4 py-2 text-sm font-medium btn-3d\">Try Now</a></div></div><div class=\"relative z-50 mx-auto flex w-full flex-col items-center justify-between bg-transparent px-0 py-2 lg:hidden\" style=\"max-width:100%;border-radius:0px;padding-left:0px;padding-right:0px\"><div class=\"flex w-full flex-row items-center justify-between\"><div class=\"flex-shrink-0 z-20\"><a class=\"text-2xl font-bold text-foreground tracking-tight hover:opacity-80 transition-opacity\" href=\"/\">NAVIO</a></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"tabler-icon tabler-icon-menu-2 text-black dark:text-white\"><path d=\"M4 6l16 0\"></path><path d=\"M4 12l16 0\"></path><path d=\"M4 18l16 0\"></path></svg></div></div></div></div><div class=\"container mx-auto px-4 md:px-6 2xl:max-w-[1400px] py-24 lg:py-32\"><div class=\"text-center mb-16\"><h1 class=\"text-4xl sm:text-5xl lg:text-6xl font-bold mb-6\">Privacy Policy</h1><p class=\"text-lg sm:text-xl max-w-3xl mx-auto text-muted-foreground\">Your privacy is fundamental to how we build and operate SAIL. This policy explains how we collect, use, and protect your information.</p><div class=\"flex items-center justify-center gap-2 mt-4 text-sm text-muted-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar h-4 w-4\" aria-hidden=\"true\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg><span>Last updated: December 2024</span></div></div><div class=\"mb-16\"><div class=\"text-center mb-12\"><h2 class=\"text-3xl font-bold mb-4\">Our Privacy Principles</h2><p class=\"text-lg text-muted-foreground max-w-2xl mx-auto\">These core principles guide everything we do with your data</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-4 gap-6\"><div data-slot=\"card\" class=\"bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm text-center\"><div data-slot=\"card-header\" class=\"@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6\"><div class=\"mx-auto mb-4 p-3 bg-primary/10 rounded-full w-fit\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield h-6 w-6\" aria-hidden=\