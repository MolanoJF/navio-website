 0\"></path><path d=\"M4 12l16 0\"></path><path d=\"M4 18l16 0\"></path></svg></div></div></div></div><div class=\"container mx-auto px-4 md:px-6 2xl:max-w-[1400px] py-24 lg:py-32\"><div class=\"text-center mb-16\"><h1 class=\"text-4xl sm:text-5xl lg:text-6xl font-bold mb-6\">Security &amp; Compliance</h1><p class=\"text-lg sm:text-xl max-w-3xl mx-auto text-muted-foreground\">Enterprise-grade security that keeps your data safe and your users protected. Built for the most demanding compliance requirements.</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16\"><div data-slot=\"card\" class=\"bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm text-center\"><div data-slot=\"card-header\" class=\"@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6\"><div class=\"mx-auto mb-4 p-3 bg-primary/10 rounded-full w-fit\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield h-6 w-6\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg></div><div data-slot=\"card-title\" class=\"font-semibold text-xl\">SOC 2 Type II Compliance</div></div><div data-slot=\"card-content\" class=\"px-6\"><div data-slot=\"card-description\" class=\"text-muted-foreground text-base\">Enterprise-grade security with annual audits and continuous monitoring</div></div></div><div data-slot=\"card\" class=\"bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm text-center\"><div data-slot=\"card-header\" class=\"@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6\"><div class=\"mx-auto mb-4 p-3 bg-primary/10 rounded-full w-fit\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock h-6 w-6\" aria-hidden=\"true\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg></div><div data-slot=\"card-title\" class=\"font-semibold text-xl\">End-to-End Encryption</div></div><div data-slot=\"card-content\" class=\"px-6\"><div data-slot=\"card-description\" class=\"text-muted-foreground text-base\">All data is encrypted in transit and at rest using industry-standard protocols</div></div></div><div data-slot=\"card\" class=\"bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm text-center\"><div data-slot=\"card-header\" class=\"@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6\"><div class=\"mx-auto mb-4 p-3 bg-primary/10 rounded-full w-fit\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye h-6 w-6\" aria-hidden=\"true\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></div><div data-slot=\"card-title\" class=\"font-semibold text-xl\">Privacy by Design</div></div><div data-slot=\"card-content\" class=\"px-6\"><div data-slot=\"card-description\" class=\"text-muted-foreground text-base\">Built with privacy-first principles and GDPR compliance</div></div></div><div data-slot=\"card\" class=\"bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm text-center\"><div data-slot=\"card-header\" class=\"@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6\"><div class=\"mx-auto mb-4 p-3 bg-primary/10 rounded-full w-fit\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-6 w-6\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><div data-slot=\"card-title\" class=\"font-semibold text-xl\">Role-Based Access Control</div></div><div data-slot=\"card-content\" class=\"px-6\"><div data-slot=\"card-description\" class=\"text-muted-foreground text-base\">Granular permissions and audit trails for all user actions</div></div></div><div data-slot=\"card\" class=\"bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm text-center\"><div data-slot=\"card-header\" class=\"@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6\"><div class=\"mx-auto mb-4 p-3 bg-primary/10 rounded-full w-fit\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-check h-6 w-6\" aria-hidden=\"true\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"m9 15 2 2 4-4\"></path></svg></div><div data-slot=\"card-title\" class=\"font-semibold text-xl\">Regular Security Audits</div></div><div data-slot=\"card-content\" class=\"px-6\"><div data-slot=\"card-description\" class=\"text-muted-foreground text-base\">Third-party penetration testing and vulnerability assessments</div></div></div></div><div class=\"mb-16\"><div class=\"text-center mb-12\"><h2 class=\"text-3xl font-bold mb-4\">Industry Standards &amp; Compliance</h2><p class=\"text-lg text-muted-foreground max-w-2xl mx-auto\">SAIL meets and exceeds the highest security standards in the industry, ensuring your data is protected at every level.</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-4\"><div class=\"flex items-center gap-3 p-4 bg-muted/50 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-green-500 flex-shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"font-medium\">SOC 2 Type II</span></div><div class=\"flex items-center gap-3 p-4 bg-muted/50 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-green-500 flex-shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"font-medium\">GDPR</span></div><div class=\"flex items-center gap-3 p-4 bg-muted/50 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-green-500 flex-shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"font-medium\">CCPA</span></div><div class=\"flex items-center gap-3 p-4 bg-muted/50 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-green-500 flex-shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"font-medium\">HIPAA Ready</span></div><div class=\"flex items-center gap-3 p-4 bg-muted/50 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-green-500 flex-shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"font-medium\">ISO 27001</span></div><div class=\"flex items-center gap-3 p-4 bg-muted/50 rounded-lg\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-5 w-5 text-green-500 flex-shrink-0\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"font-medium\">FedRAMP (In Progress)</span></div></div></div><div class=\"mb-16\"><div class=\"text-center mb-12\"><h2 class=\"text-3xl font-bold mb-4\">Security Architecture</h2><p class=\"text-lg text-muted-foreground max-w-3xl mx-auto\">Our multi-layered security approach ensures comprehensive protection for your application and user data.</p></div><div class=\"grid lg:grid-cols-2 gap-8 items-center\"><div class=\"space-y-6\"><div class=\"space-y-4\"><h3 class=\"text-xl font-semibold\">Data Protection</h3><ul class=\"space-y-2 text-muted-foreground\"><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-4 w-4 text-green-500\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>AES-256 encryption for data at rest</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-4 w-4 text-green-500\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>TLS 1.3 for data in transit</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-4 w-4 text-green-500\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Secure key management with AWS KMS</li></ul></div><div class=\"space-y-4\"><h3 class=\"text-xl font-semibold\">Access Control</h3><ul class=\"space-y-2 text-muted-foreground\"><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-4 w-4 text-green-500\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Multi-factor authentication (MFA)</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-4 w-4 text-green-500\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Single sign-on (SSO) integration</li><li class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-4 w-4 text-green-500\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>IP whitelisting and geofencing</li></ul></div></div><div class=\"bg-muted/30 p-8 rounded-2xl\"><div class=\"space-y-6\"><div class=\"text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield h-16 w-16 mx-auto text-primary mb-4\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg><h3 class=\"text-xl font-semibold mb-2\">Security First</h3><p class=\"text-muted-foreground\">Every feature is built with security in mind, from the ground up.</p></div><div class=\"space-y-4\"><div class=\"flex items-center justify-between p-3 bg-background rounded-lg\"><span class=\"text-sm font-medium\">Vulnerability Scanning</span><span data-slot=\"badge\" class=\"inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 [&amp;&gt;svg]:size-3 gap-1 [&amp;&gt;svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden border-transparent bg-secondary text-secondary-foreground [a&amp;]:hover:bg-secondary/90\">Daily</span></div><div class=\"flex items-center justify-between p-3 bg-background rounded-lg\"><span class=\"text-sm font-medium\">Penetration Testing</span><span data-slot=\"badge\" class=\"inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fi