{
    "main": ".open-next/worker.js",
    "name": "navio-website",
    "compatibility_date": "2025-03-25",
    "compatibility_flags": [
      "nodejs_compat"
    ],
    "routes": [
      {
        "pattern": "naviobot.com/*",
        "zone_name": "naviobot.com"
      }
    ],
    "assets": {
      "directory": ".open-next/assets",
      "binding": "ASSETS"
    },
    "env": {
      "production": {}
    }
  }